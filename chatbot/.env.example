# --- Google / LLM ---
GOOGLE_API_KEY=
LAW_MAIN_STORE_NAME=
COHERE_API_KEY=

# --- Data layer ---
MONGO_URI=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# --- Auth ---
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# --- Email (Gmail SMTP) ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Frontend / CORS ---
# Canonical frontend origin (used for verification-email links and as the
# default CORS allow-origin). Override CORS_ALLOW_ORIGINS for multi-origin.
FRONTEND_URL=http://localhost:3000
# Comma-separated allow-list, e.g. "https://app.example.com,https://staging.example.com".
# Defaults to FRONTEND_URL.
CORS_ALLOW_ORIGINS=

# --- Cookies (auth) ---
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
# "lax" is the safe default. Use "none" only with Secure=true if FE/BE are on
# different eTLD+1 domains and you need cross-site requests.
COOKIE_SAMESITE=lax
# Leave blank in dev. In prod set to your eTLD+1 (e.g. ".example.com") if you
# want the cookie to be shared between app.example.com and api.example.com.
COOKIE_DOMAIN=
